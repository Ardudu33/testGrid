# Hyperliquid API Credentials
HYPERLIQUID_API_KEY="YOUR_API_KEY"
HYPERLIQUID_API_SECRET="YOUR_API_SECRET"
HYPERLIQUID_WALLET_ADDRESS="YOUR_WALLET_ADDRESS" # e.g., 0x...

# Trading Parameters
HYPE_ASSET_NAME="HYPE"
USDC_ASSET_NAME="USDC"
GRID_SPACING="0.005"  # Percentage_decimal (e.g., 0.5% = 0.005)
GRID_LEVELS="10"       # Total number of grid levels (e.g., 10 means 5 above, 5 below center)
BASE_ORDER_SIZE_USDC="20.0" # Size of each order in USDC
LOOP_INTERVAL_SECONDS="60" # Time between each trading loop iteration

# Optional: Specify path to Hyperliquid SDK if not installed in standard Python paths
# HYPERLIQUID_SDK_PATH="/path/to/hyperliquid-python-sdk"
